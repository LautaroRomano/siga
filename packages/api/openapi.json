    "/api/v1/members/{userId}": {
      "delete": {
        "tags": [
          "Miembros"
        ],
        "summary": "Quitar un miembro de la organización",
        "description": "La cuenta sigue existiendo con su organización propia; si tenía esta organización activa, su sesión vuelve a la propia en el próximo request. El Administrador no se puede quitar (400).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "userId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Miembro quitado",
