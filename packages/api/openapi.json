{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "1.0.0",
    "description": "Sesión, organizaciones, miembros e invitaciones. Autenticación por cookie (web) o bearer token (móvil)."
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyOrganization"
            },
            "description": "Todas las organizaciones de la cuenta: la propia y las que la invitaron"
          },
          "lostOrganization": {
            "$ref": "#/components/schemas/LostOrganization"
          }
        },
        "required": [
          "userId",
          "userName",
          "userEmail",
          "organizationId",
          "role",
          "organizations",
          "lostOrganization"
        ]
      },
      "MyOrganization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      },
      "LostOrganization": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "description": "La organización activa dejó de tener membresía y la sesión volvió a la propia; `null` en el resto de los casos."
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "email",
          "role",
          "createdAt"
        ]
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "ok"
        ]
      },
      "PendingInvitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "expiresAt",
          "createdAt"
        ]
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "REJECTED",
              "CANCELED",
              "EXPIRED"
            ]
          },
          "expiresAt": {
            "type": "string"
          },
          "forCurrentUser": {
            "type": "boolean",
            "description": "La invitación es para el email de la sesión"
          }
        },
        "required": [
          "id",
          "organizationName",
          "status",
          "expiresAt",
          "forCurrentUser"
        ]
      },
      "InvitationResolution": {
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string"
          }
        },
        "required": [
          "organizationName"
        ]
      },
      "DailyCronResult": {
        "type": "object",
        "properties": {
          "emails": {
            "$ref": "#/components/schemas/CronResult"
          },
          "purgedRateLimitBuckets": {
            "type": "number"
          }
        },
        "required": [
          "emails",
          "purgedRateLimitBuckets"
        ]
      },
      "CronResult": {
        "type": "object",
        "properties": {
          "processed": {
            "type": "number"
          },
          "failed": {
            "type": "number"
          }
        },
        "required": [
          "processed",
          "failed"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "Sesión"
        ],
        "summary": "Quién soy: usuario, rol y organización activa",
        "description": "`organizations` lista todas las organizaciones de la cuenta (la propia y las que la invitaron), para el selector de organización.",
        "responses": {
          "200": {
            "description": "Sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
